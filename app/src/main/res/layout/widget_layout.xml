<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_today_background"
    android:orientation="vertical"
    android:padding="0dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="@drawable/widget_today_header"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="TODAY · Saturday 19 September"
            android:textColor="#FF111111"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_todo_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="#A0000000"
            android:textSize="8sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_book_pixel"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:background="@drawable/widget_pixel_band"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="24dp"
        android:paddingEnd="10dp"
        android:text="RED RISING"
        android:textAllCaps="true"
        android:textColor="#FF111111"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_bento_pixel"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:background="@drawable/widget_pixel_band"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="24dp"
        android:paddingEnd="10dp"
        android:text="🍱 SALMON BENTO"
        android:textAllCaps="true"
        android:textColor="#FF111111"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_note_preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="top"
        android:lineSpacingExtra="1dp"
        android:maxLines="5"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:text="No tasks yet"
        android:textColor="#FF111111"
        android:textSize="12sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/widget_checklist"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@drawable/widget_divider"
        android:dividerHeight="1dp"
        android:fadingEdge="vertical"
        android:paddingTop="0dp"
        android:paddingBottom="1dp"
        android:scrollbars="none" />

</LinearLayout>
